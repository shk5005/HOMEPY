# 토스증권 Open API 자격증명 (개발자센터에서 발급)
# 이 파일을 .env 로 복사해 값을 채우세요. .env 는 .gitignore 로 제외됩니다.
TOSSINVEST_CLIENT_ID=tsck_live_xxxxxxxxxxxxxxxxxxxx
TOSSINVEST_CLIENT_SECRET=tssk_live_xxxxxxxxxxxxxxxxxxxx

# (선택) 계좌 API 사용 시
TOSSINVEST_ACCOUNT=

# (선택) 베이스 URL 오버라이드
TOSSINVEST_API_BASE_URL=https://openapi.tossinvest.com
