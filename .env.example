# 지니 로컬 설정 예시. 복사해서 .env 로 쓰고 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않습니다.

# ── 토스증권 오픈 API ─────────────────────────────
# 발급받은 키. 설정되면 프록시가 오픈 API 를 사용하고,
# 없으면 비공식 WTS 경로로 동작합니다.
GENIE_TOSS_API_KEY=

# ── 아래는 공식 문서에 맞춰 조정하는 값들 ──────────
# 문서를 확인하지 못한 채 기본값을 넣어두었으므로,
# 401/404 가 나면 여기부터 맞추세요. 코드 수정은 필요 없습니다.

# TOSS_API_BASE=https://openapi.tossinvest.com
# TOSS_AUTH_STYLE=bearer        # bearer | header | query | basic
# TOSS_AUTH_HEADER=X-API-Key    # AUTH_STYLE=header 일 때 헤더 이름
# TOSS_AUTH_PARAM=apiKey        # AUTH_STYLE=query 일 때 파라미터 이름
# TOSS_QUOTE_PATH=/v1/stocks/prices
# TOSS_SEARCH_PATH=/v1/stocks/search
# TOSS_CODE_PARAM=codes
# TOSS_QUERY_PARAM=query
